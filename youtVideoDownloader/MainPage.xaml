<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:youtVideoDownloader.ViewModels"
             xmlns:models="clr-namespace:youtVideoDownloader.Models"
             x:Class="youtVideoDownloader.MainPage"
             x:DataType="viewmodels:MainViewModel"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                <!-- A placeholder icon for StreamVault -->
                <Label Text="SV" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource PrimaryAccent}" VerticalOptions="Center"/>
                <Label Text="StreamVault" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Video URL Input -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Video URL" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold"/>
                <Border Stroke="{StaticResource DividerColor}" BackgroundColor="{StaticResource CardBackground}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0" Text="{Binding VideoUrl}" Placeholder="Paste YouTube link here..." PlaceholderColor="{StaticResource TextSecondary}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        <ImageButton Grid.Column="1" Command="{Binding PasteFromClipboardCommand}" Source="dotnet_bot.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Opacity="0.5"/>
                    </Grid>
                </Border>

                <!-- Fetch Button -->
                <Button Text="🔍 Fetch Video Info" Command="{Binding FetchVideoInfoCommand}" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryAccent}" HorizontalOptions="Center" />

            <!-- Status Text -->
            <Label Text="{Binding StatusText}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />

            <!-- Video Info Card -->
            <Border IsVisible="{Binding HasVideoInfo}" BackgroundColor="{StaticResource CardBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <VerticalStackLayout>
                    <Grid>
                        <Image Source="{Binding VideoInfo.ThumbnailUrl}" Aspect="AspectFill" HeightRequest="180" />
                        <Border BackgroundColor="#CC000000" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="5,2" HorizontalOptions="End" VerticalOptions="End" Margin="10">
                            <Label Text="{Binding VideoInfo.Duration}" TextColor="White" FontSize="12"/>
                        </Border>
                    </Grid>
                    <VerticalStackLayout Padding="15" Spacing="5">
                        <Label Text="{Binding VideoInfo.Title}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" FontSize="18" LineBreakMode="TailTruncation" MaxLines="2" />
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="👤" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding VideoInfo.Author}" TextColor="{StaticResource TextSecondary}" FontSize="14"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Download Options Card -->
            <Border IsVisible="{Binding HasVideoInfo}" BackgroundColor="{StaticResource CardBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Download Options" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold"/>
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Format" TextColor="{StaticResource TextSecondary}" FontSize="12"/>
                            <Border Stroke="{StaticResource DividerColor}" BackgroundColor="{StaticResource CardBackgroundLight}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <Picker ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" TextColor="{StaticResource TextPrimary}" TitleColor="{StaticResource TextPrimary}" Margin="10,0"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Quality" TextColor="{StaticResource TextSecondary}" FontSize="12"/>
                            <Border Stroke="{StaticResource DividerColor}" BackgroundColor="{StaticResource CardBackgroundLight}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <Picker ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" TextColor="{StaticResource TextPrimary}" TitleColor="{StaticResource TextPrimary}" Margin="10,0"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Download Progress Area -->
            <Border IsVisible="{Binding IsDownloading}" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource PrimaryAccent}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Grid>
                        <Label Text="Downloading..." TextColor="{StaticResource PrimaryAccent}" FontFamily="OpenSansSemibold" HorizontalOptions="Start"/>
                        <!-- We would calculate MB/s and Time left here, for now it uses StatusText from viewmodel -->
                        <Label Text="{Binding DownloadProgress, StringFormat='{0:P0}'}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" HorizontalOptions="End"/>
                    </Grid>
                    
                    <ProgressBar Progress="{Binding DownloadProgress}" ProgressColor="{StaticResource PrimaryAccent}" />
                </VerticalStackLayout>
            </Border>

            <!-- Download Button -->
            <Button IsVisible="{Binding HasVideoInfo}" Text="⬇ Download Now" Command="{Binding DownloadCommand}" BackgroundColor="{StaticResource CardBackgroundLight}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" CornerRadius="8" HeightRequest="50"/>

            <!-- Cancel Button -->
            <Button IsVisible="{Binding IsBusy}" Text="❌ Cancel Operation" Command="{Binding CancelCommand}" BackgroundColor="#88FF0000" TextColor="White" FontFamily="OpenSansSemibold" CornerRadius="8" HeightRequest="50" Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
